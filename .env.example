# Integracion server-to-server con la aplicacion externa de IA.
INTEGRAQ_AI_ENDPOINT=
INTEGRAQ_MANAGEMENT_REVIEW_AI_ENDPOINT=
INTEGRAQ_FORM_IMPORT_AI_ENDPOINT=
INTEGRAQ_AI_API_KEY=

# Alternativa directa para lectura visual de fotografías.
OPENAI_API_KEY=
OPENAI_FORM_IMPORT_MODEL=gpt-4.1-mini

# Supabase: la clave publica puede llegar al navegador; la secreta es solo servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para aplicar la migracion y crear el primer administrador localmente.
SUPABASE_DB_URL=
INTEGRAQ_ADMIN_EMAIL=
INTEGRAQ_ADMIN_PASSWORD=
