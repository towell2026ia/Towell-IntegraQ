# Copiar a .env.recovery.local. Este archivo sólo admite Supabase local.
APP_ENV=recovery-local
NEXT_PUBLIC_APP_ENV=recovery-local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Ubicación opcional del snapshot. Si queda vacía se usa el backup más reciente.
RECOVERY_BACKUP_DIR=

# Contraseña temporal exclusiva de Recovery, mínimo 12 caracteres. No versionar el valor.
RECOVERY_DEFAULT_PASSWORD=

# Sólo si el nombre local difiere del project_id de supabase/config.toml.
RECOVERY_DB_CONTAINER=supabase_db_integraq-recovery
